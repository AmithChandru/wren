{
  // Type-checks the Prisma seed script, which lives outside `src` (and so outside
  // the main build's rootDir). Checked by the `typecheck` script; never emitted —
  // the seed runs via tsx, not the compiled output.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["prisma/seed.ts"]
}
