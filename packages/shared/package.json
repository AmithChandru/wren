{
  "name": "@wren/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "default": "./dist/providers.js"
    },
    "./character": {
      "types": "./dist/character/index.d.ts",
      "default": "./dist/character/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.smoke.json",
    "lint": "eslint .",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.102.0",
    "openai": "6.42.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "tsx": "4.22.4"
  }
}
