# Copy to .env and fill what you have.
# Everything that can default to a `mock` provider does, so the app runs with ONLY a DATABASE_URL.
# (.env is denied to the Claude Code agent and is gitignored — never commit real keys.)

# ---- Database (required) ----
# Local pgvector via Docker:
#   docker run -d --name pgvector -e POSTGRES_PASSWORD=postgres -p 5432:5432 pgvector/pgvector:pg16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/character_platform

# ---- LLM (brain) ----
# LLM_PROVIDER=mock makes the app run with no key. Set to `anthropic` + a key for real answers.
LLM_PROVIDER=mock                 # mock | anthropic
ANTHROPIC_API_KEY=
# Model IDs change — confirm the current string at docs.claude.com before relying on this default.
LLM_MODEL=claude-sonnet-4-6

# ---- Embeddings (for RAG) ----
EMBEDDINGS_PROVIDER=mock          # mock | openai | voyage
OPENAI_API_KEY=
# text-embedding-3-small is 1536-dim. EMBEDDINGS_DIM MUST match the vector(N) column in the DB.
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536
# Voyage (Anthropic's recommended embeddings) — if EMBEDDINGS_PROVIDER=voyage:
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3            # check dimension and set EMBEDDINGS_DIM + the DB column to match

# ---- TTS (voice) ----
TTS_PROVIDER=mock                 # mock | elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_turbo_v2_5   # low-latency family; verify current id at the ElevenLabs docs

# ---- Character renderer ----
CHARACTER_RENDERER=svg            # svg (default, no asset) | rive (needs a .riv asset)
NEXT_PUBLIC_CHARACTER_RENDERER=svg

# ---- Server / web ----
PORT=8787
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787

# ---- Admin / security ----
# Required header (x-admin-secret) for ingest + any admin/write route in v1.
ADMIN_API_SECRET=change-me-in-dev

NODE_ENV=development
